#!/bin/sh
# Started by greetd (as the "greeter" user) to show the login screen:
# a minimal Hyprland whose only client is the Quickshell greeter. When the
# greeter quits (after a successful login), Hyprland exits and greetd starts
# the chosen session.
#
# Safety net: if Hyprland or Quickshell is missing, fall back to agreety, the
# text greeter shipped with greetd, so a broken install never locks you out.

SHARE=/usr/share/archminimal-greeter
ETC=/etc/archminimal-greeter
STATE=/var/cache/archminimal-greeter

if ! command -v Hyprland >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1 || [ ! -f "$SHARE/shell.qml" ]; then
    echo "archminimal-greeter: Hyprland, quickshell or the greeter files are missing; using agreety" >&2
    exec agreety --cmd "${SHELL:-/bin/bash}"
fi

# The greeter user has no writable home; keep caches in the state directory.
export XDG_CACHE_HOME="$STATE/cache"
export XDG_STATE_HOME="$STATE/state"
export XDG_DATA_HOME="$STATE/data"
export ARCHMINIMAL_CONFIG="$ETC/config.json"
export ARCHMINIMAL_STATE_DIR="$STATE"
export ARCHMINIMAL_SHARE="$SHARE"
export QT_QPA_PLATFORM=wayland

# Hyprland 0.53+ expects to be launched by its watchdog, start-hyprland
# (it warns on screen otherwise). The watchdog restarts Hyprland only after a
# crash; the clean exit after a successful login passes through to greetd.
#
# Not `exec`: wait for it. A clean exit (0) is the greeter quitting after a
# login, so greetd starts the session. Anything else means Hyprland could not
# run (no 3D in a VM, a crash after an update): fall back to agreety, instead
# of greetd restarting a greeter that fails the same way every time.
# a log from an earlier boot must not count as a login
if ! rm -f "$STATE/greeter.log"; then
    echo "archminimal-greeter: can't clear $STATE/greeter.log; using agreety" >&2
    exec agreety --cmd "${SHELL:-/bin/bash}"
fi
if command -v start-hyprland >/dev/null 2>&1; then
    start-hyprland -- --config "$SHARE/hyprland.lua" >/dev/null 2>&1
else
    Hyprland --config "$SHARE/hyprland.lua" >/dev/null 2>&1
fi
rc=$?
# hyprland.lua exits Hyprland cleanly whenever qs ends, also when the greeter
# failed to load: only the line Greeter.qml logs once greetd accepted a session
# means a login happened. Without it greetd would restart the same broken greeter.
if [ "$rc" -eq 0 ]; then
    # the whole line must end with the marker and hold no other "archminimal:":
    # PAM and greetd messages are logged too and could carry the text
    awk -v m='archminimal: launched: greetd accepted the session; quitting' '
        { n = gsub(/archminimal:/, "&") }
        n == 1 && length($0) >= length(m) && substr($0, length($0) - length(m) + 1) == m { ok = 1 }
        END { exit !ok }' "$STATE/greeter.log" 2>/dev/null && exit 0
    echo "archminimal-greeter: the greeter ended without a login (see $STATE/greeter.log); using agreety" >&2
else
    echo "archminimal-greeter: Hyprland exited with status $rc; using agreety" >&2
fi
exec agreety --cmd "${SHELL:-/bin/bash}"
